# Zebra Release Intelligence Platform - Environment Configuration Template
# DO NOT COMMIT PRODUCTION SECRETS OR REAL SERVICE ACCOUNT KEYS.

# GEMINI_API_KEY: Optional for AI Studio runtime
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Host URL for self-referential links
APP_URL="MY_APP_URL"

# JIRA ENTERPRISE CLOUD INTEGRATION
JIRA_INSTANCE_URL="https://jira.internal.zebra.com"
JIRA_SERVICE_ACCOUNT_EMAIL="svc-release-intel@internal.zebra.com"
JIRA_API_TOKEN="YOUR_SECURE_JIRA_SERVICE_TOKEN"
JIRA_PROJECT_KEYS="ZEB,SEC,LNK,AUR,BSP,SCAN"

# VULNERABILITY SOURCES (CVE.ORG & NVD NIST)
NVD_API_KEY="YOUR_NVD_NIST_API_KEY"
NVD_API_ENDPOINT="https://services.nvd.nist.gov/rest/json/cves/2.0"
CVE_ORG_ENDPOINT="https://cveawg.mitre.org/api/cve"

# DATA ENVIRONMENT MODE
VITE_DATA_MODE="DEMO" # Options: DEMO | PRODUCTION
